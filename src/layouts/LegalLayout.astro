---
import { company } from '../data/company';
interface Props { title: string; description: string; path: string }
const { title, description, path } = Astro.props;
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={`https://privacyshieldgroup.com${path}`} />
<meta name="robots" content="index, follow" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<style>
/* ── Self-hosted fonts ────────────────────────────────────────────────────── */

/* Inter - variable font (400-700) */
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: url('/fonts/inter-latin.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: url('/fonts/inter-latin-ext.woff2') format('woff2');
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}

/* Cormorant Garamond - normal (400-700) */
@font-face {
  font-family: 'Cormorant Garamond';
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: url('/fonts/cormorant-latin.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Cormorant Garamond';
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: url('/fonts/cormorant-latin-ext.woff2') format('woff2');
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}

/* Cormorant Garamond - italic (400) */
@font-face {
  font-family: 'Cormorant Garamond';
  font-style: italic;
  font-weight: 400;
  font-display: swap;
  src: url('/fonts/cormorant-italic-latin.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Cormorant Garamond';
  font-style: italic;
  font-weight: 400;
  font-display: swap;
  src: url('/fonts/cormorant-italic-latin-ext.woff2') format('woff2');
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
:root {
  --navy: #0a1628; --navy-mid: #18254F; --gold: #C8A96E; --gold-dark: #A68B52;
  --cream: #F5F3EF; --off-white: #f4f5f7; --gray-500: #6B7280; --gray-700: #374151;
}
* { box-sizing: border-box; }
body { margin:0; background: var(--off-white); color: var(--gray-700);
       font-family: 'Inter', -apple-system, system-ui, sans-serif; font-size: 15px; line-height: 1.75; }
.bar { background: var(--navy); padding: 1.1rem 0; }
.container { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }
.brand { color:#fff; font-family:'Cormorant Garamond',Georgia,serif; font-size:1.2rem; text-decoration:none; letter-spacing:.02em; }
.brand span { color: var(--gold); }
main { padding: 3.5rem 0 4rem; }
.eyebrow { font-size:.68rem; font-weight:600; letter-spacing:.18em; text-transform:uppercase; color: var(--gold-dark); }
h1 { font-family:'Cormorant Garamond',Georgia,serif; font-weight:600; color: var(--navy-mid);
     font-size: clamp(1.9rem,4vw,2.5rem); line-height:1.15; margin:.4rem 0 0; }
.rule { width:3rem; height:2px; background: var(--gold); margin:1.1rem 0 2rem; }
h2 { font-family:'Cormorant Garamond',Georgia,serif; font-weight:600; color: var(--navy-mid);
     font-size:1.4rem; margin:2.2rem 0 .6rem; }
p, li { margin:0 0 .9rem; }
ul { padding-left:1.1rem; }
a { color: var(--gold-dark); }
.meta { border-top:1px solid #e3e0da; margin-top:2.5rem; padding-top:1.2rem; font-size:.85rem; color: var(--gray-500); }
footer { background: var(--navy); color: rgba(255,255,255,.55); font-size:.8rem; padding:1.6rem 0; }
footer a { color: rgba(255,255,255,.75); }
</style>
</head>
<body>
<div class="bar"><div class="container"><a class="brand" href="/">Privacy <span>Shield</span> Group</a></div></div>
<main><div class="container"><slot /></div></main>
<footer><div class="container">&copy; {year} {company.legalName} &middot; <a href="/">Back to the site</a></div></footer>
</body>
</html>
