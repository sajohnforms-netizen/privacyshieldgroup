  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}

:root {
  --navy-deep: #0E1630;
  --navy: #0a1628;
  --navy-mid: #18254F;
  --navy-soft: #243566;
  --gold: #C8A96E;
  --gold-light: #D9C08C;
  --gold-pale: #e8dbc0;
  --gold-dark: #A68B52;
  --gold-glow: rgba(196,162,101,0.10);
  --gold-glow-strong: rgba(196,162,101,0.18);
  --white: #ffffff;
  --off-white: #f4f5f7;
  --cream: #F5F3EF;
  --warm-gray: #EAE7E1;
  --gray-100: #e8e4dd;
  --gray-200: #d1ccc3;
  --gray-300: #b5afa5;
  --gray-400: #8c867c;
  --gray-500: #6b655b;
  --gray-600: #4a4640;
  --gray-700: #2e2b27;
  --soft-green: #3a8a4a;
  --soft-green-bg: #f2f9f3;
  --font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
  --font-body: 'Inter', -apple-system, system-ui, sans-serif;
  --shadow-subtle: 0 2px 12px rgba(6,13,26,0.04);
  --shadow-soft: 0 4px 24px rgba(6,13,26,0.06);
  --shadow-lift: 0 12px 40px rgba(6,13,26,0.08);
  --shadow-gold: 0 8px 36px rgba(196,162,101,0.14);
  --radius: 2px;
  --radius-lg: 2px;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

body {
  font-family: var(--font-body);
  color: var(--gray-600);
  line-height: 1.75;
  overflow-x: hidden;
  background: var(--white);
}

.container { max-width: 1100px; margin: 0 auto; padding: 0 32px; }

/* ===== NAVIGATION ===== */
/* Same header as sajrecherche.com: fixed solid navy bar, 80px, shadow */
.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: var(--navy); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1); }
.nav .container { display: flex; justify-content: space-between; align-items: center; gap: 16px; height: 80px; max-width: 1280px; }
.nav-phone, .nav-cta, .logo-text strong { white-space: nowrap; }
.nav-spacer { height: 80px; }
.logo-mark { display: flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0; }
.logo-shield { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
.logo-shield svg { width: 100%; height: 100%; }
.logo-text { line-height: 1.2; }
.logo-text strong { display: block; font-family: var(--font-display); font-size: 18px; font-weight: 600; color: var(--white); letter-spacing: 0.5px; }
.logo-text small { display: block; font-size: 10px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(200,169,110,0.8); }
.nav-links { display: flex; align-items: center; gap: 4px; }
.nav-links a { padding: 8px 16px; font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.8); text-decoration: none; border-bottom: 2px solid transparent; transition: color 0.2s; }
.nav-links a:hover { color: var(--white); }
.nav-links a.is-active { color: var(--gold); border-bottom-color: var(--gold); }
.nav-right { display: flex; align-items: center; gap: 16px; }
.nav-phone { display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(200,169,110,0.4); background: rgba(200,169,110,0.1); border-radius: var(--radius); padding: 6px 12px; font-size: 12px; font-weight: 600; color: var(--gold); text-decoration: none; transition: background 0.2s; }
.nav-phone:hover { background: rgba(200,169,110,0.2); }
.nav-phone svg { width: 14px; height: 14px; }
.nav-cta { font-size: 12px; padding: 10px 20px; }
.nav-toggle { display: none; width: 40px; height: 40px; flex-direction: column; align-items: center; justify-content: center; gap: 6px; background: none; border: 0; cursor: pointer; }
.nav-toggle span { display: block; height: 2px; width: 24px; background: var(--white); transition: transform 0.2s, opacity 0.2s; }
.nav-toggle span:last-child { width: 16px; }
.nav-mobile { display: none; border-top: 1px solid rgba(255,255,255,0.1); background: var(--navy); padding: 8px 0 20px; }
.nav-mobile.is-open { display: block; }
.nav-mobile .container { display: block; height: auto; max-height: 80vh; overflow-y: auto; }
.nav-mobile a { display: block; padding: 12px; font-size: 16px; font-weight: 500; color: rgba(255,255,255,0.8); text-decoration: none; border-left: 2px solid transparent; }
.nav-mobile a:hover { color: var(--white); border-left-color: rgba(255,255,255,0.3); }
.nav-mobile .btn-primary { margin: 12px 12px 0; justify-content: center; border-left: 0; color: var(--white); }

/* ===== HERO ===== */
/* Same hero as sajrecherche.com: full image, navy gradient, badge pill, gold divider, usps, 2 buttons, stats bar */
.hero { background: var(--navy-deep); color: var(--white); position: relative; overflow: hidden; display: flex; align-items: center; min-height: 85vh; padding-bottom: 96px; }
.hero-bg { position: absolute; inset: 0; background: url('/img/hospitality.webp') center / cover no-repeat; filter: brightness(0.6) saturate(0.75); }
.hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(14,22,48,0.85) 0%, rgba(14,22,48,0.65) 50%, rgba(14,22,48,0.4) 100%); }
.hero-content { position: relative; z-index: 2; padding-top: 80px; padding-bottom: 80px; display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 56px; align-items: center; }
.hero-badge { display: inline-block; margin-bottom: 24px; border: 1px solid rgba(200,169,110,0.4); border-radius: var(--radius); padding: 4px 12px; font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
.hero h1 { font-family: var(--font-display); font-size: clamp(32px, 4.5vw, 60px); font-weight: 700; line-height: 1.1; color: var(--white); text-shadow: 0 2px 12px rgba(0,0,0,0.7); text-wrap: balance; }
.hero-divider { width: 48px; height: 2px; background: var(--gold); margin: 24px 0; }
.hero-sub { font-size: 18px; line-height: 1.65; color: rgba(255,255,255,0.8); max-width: 42rem; text-shadow: 0 1px 8px rgba(0,0,0,0.5); }
.hero-usps { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 24px; }
.hero-usps li { display: flex; align-items: center; gap: 8px; font-size: 14px; color: rgba(255,255,255,0.7); }
.hero-usps li::before { content: '\2713'; color: var(--gold); }
.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 32px; }
/* Buttons: identical to sajrecherche .btn--primary / .btn--white */
.btn-primary, .btn-white { display: inline-flex; align-items: center; gap: 8px; padding: 14px 32px; border-radius: var(--radius); font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; transition: background 0.2s, color 0.2s; }
.btn-primary { background: var(--navy-mid); color: var(--white); }
.btn-primary:hover { background: var(--navy-deep); }
.btn-primary:active { transform: translateY(1px); }
.btn-white { border: 1px solid rgba(255,255,255,0.6); color: var(--white); }
.btn-white:hover { background: rgba(255,255,255,0.1); }
.btn-white svg { width: 16px; height: 16px; }
/* Stats bar (bottom of hero) */
.hero-stats { position: absolute; bottom: 0; left: 0; right: 0; z-index: 2; border-top: 1px solid rgba(255,255,255,0.1); background: rgba(14,22,48,0.6); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
.hero-stats .container { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding-top: 20px; padding-bottom: 20px; }
.hero-stat { text-align: center; }
.hero-stat strong { display: block; font-family: var(--font-display); font-size: 30px; font-weight: 700; color: var(--gold); line-height: 1.2; }
.hero-stat span { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: rgba(255,255,255,0.6); }

/* Hero badge: static, no animation */
.hero-right { display: flex; justify-content: center; align-items: center; }
.hero-badge-main { width: 280px; height: 280px; }
.hero-badge-main svg { width: 100%; height: 100%; filter: drop-shadow(0 14px 34px rgba(0,0,0,0.4)); }

/* ===== SECTIONS SHARED ===== */
.section { padding: 96px 0; }
.section-dark { background: var(--navy); color: var(--white); }
.section-cream { background: var(--cream); }
.section-off-white { background: var(--off-white); }

.section-eyebrow { display: inline-flex; align-items: center; gap: 12px; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--gold-dark); margin-bottom: 24px; }
.section-eyebrow::before { content: ''; width: 32px; height: 1.5px; background: var(--gold); }
.section-dark .section-eyebrow { color: var(--gold); }

.section-title { font-family: var(--font-display); font-size: clamp(30px, 3.5vw, 48px); font-weight: 500; color: var(--navy); line-height: 1.15; margin-bottom: 20px; letter-spacing: -0.2px; }
.section-dark .section-title { color: var(--white); }
.text-gold { color: var(--gold); }

.section-subtitle { font-size: 17px; color: var(--gray-500); max-width: 620px; line-height: 1.85; margin-bottom: 64px; font-weight: 300; }
.section-dark .section-subtitle { color: var(--gray-300); }

/* ===== WAAROM / WHY ===== */
.waarom-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
.waarom-card { background: var(--white); border: 1px solid var(--gray-100); border-radius: var(--radius-lg); padding: 44px 36px; transition: border-color 0.25s; }
.waarom-card:hover { border-color: var(--gold); }
.waarom-icon { width: 32px; height: 32px; margin-bottom: 26px; }
.waarom-icon svg { width: 100%; height: 100%; }
.waarom-card h3 { font-family: var(--font-display); font-size: 24px; font-weight: 600; color: var(--navy); margin-bottom: 14px; line-height: 1.25; }
.waarom-card p { font-size: 15px; color: var(--gray-500); line-height: 1.8; }
.waarom-footer { text-align: center; padding-top: 40px; border-top: 1px solid var(--gray-100); }
.waarom-footer p { font-family: var(--font-display); font-size: 22px; font-weight: 500; font-style: italic; color: var(--gray-500); max-width: 680px; margin: 0 auto; line-height: 1.5; }

/* ===== CERTIFICATE ===== */
.cert-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.cert-text h3 { font-family: var(--font-display); font-size: 30px; font-weight: 600; color: var(--white); margin-bottom: 20px; line-height: 1.25; }
.cert-text p { font-size: 15px; color: var(--gray-300); line-height: 1.85; margin-bottom: 20px; }
.cert-features { display: flex; flex-direction: column; gap: 14px; margin-top: 36px; }
.cert-feature { display: flex; align-items: center; gap: 16px; padding: 14px 20px; background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; transition: all 0.3s; }
.cert-feature:hover { border-color: rgba(196,162,101,0.3); background: rgba(196,162,101,0.04); }
.cert-feature-dot { flex-shrink: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); }
.cert-feature-text { font-size: 15px; font-weight: 400; color: var(--gray-200); }

.cert-badge-area { display: flex; justify-content: center; align-items: center; }
.cert-badge-showcase { position: relative; width: 320px; height: 320px; display: flex; align-items: center; justify-content: center; }
.cert-badge-showcase svg { width: 100%; height: 100%; filter: drop-shadow(0 14px 34px rgba(0,0,0,0.4)); }
#certificate { position: relative; }
#certificate .cert-bg { position: absolute; inset: 0; background: url('/img/tscm.webp') center / cover no-repeat; opacity: 0.1; filter: grayscale(1); pointer-events: none; }
#certificate .container { position: relative; z-index: 1; }

/* ===== VOORDELEN / BENEFITS ===== */
.voordelen-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
.voordeel-card { background: var(--white); border: 1px solid var(--gray-100); border-radius: var(--radius-lg); padding: 44px; transition: border-color 0.25s; }
.voordeel-card:hover { border-color: var(--gold); }
.voordeel-tag { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 4px 12px; border-radius: var(--radius); margin-bottom: 20px; background: var(--gold-pale); color: var(--gold-dark); }
.voordeel-card h3 { font-family: var(--font-display); font-size: 24px; font-weight: 600; color: var(--navy); margin-bottom: 14px; line-height: 1.25; }
.voordeel-card p { font-size: 15px; color: var(--gray-500); line-height: 1.8; }
.voordeel-list { list-style: none; margin-top: 20px; }
.voordeel-list li { font-size: 14px; color: var(--gray-500); padding: 7px 0 7px 20px; position: relative; line-height: 1.6; }
.voordeel-list li::before { content: ''; position: absolute; left: 0; top: 15px; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }

/* ===== TRAINING ===== */
.training-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
.training-intro h3 { font-family: var(--font-display); font-size: 30px; font-weight: 600; color: var(--navy); margin-bottom: 20px; line-height: 1.25; }
.training-intro p { font-size: 16px; color: var(--gray-500); line-height: 1.85; margin-bottom: 24px; }
.training-quote { background: var(--gold-glow); border-left: 3px solid var(--gold); padding: 24px 28px; border-radius: 0 var(--radius) var(--radius) 0; margin: 28px 0; }
.training-quote p { font-family: var(--font-display); font-size: 20px; font-weight: 500; font-style: italic; color: var(--gray-600); margin-bottom: 0; line-height: 1.5; }
.training-modules { display: flex; flex-direction: column; gap: 16px; }
.t-module { background: var(--white); border: 1px solid var(--gray-100); border-radius: var(--radius); padding: 28px 32px; display: flex; align-items: flex-start; gap: 20px; transition: all 0.35s; }
.t-module:hover { border-color: var(--gold); box-shadow: var(--shadow-subtle); }
.t-module-icon { flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%; background: var(--gold-glow); border: 1px solid rgba(196,162,101,0.2); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--gold-dark); }
.t-module h4 { font-size: 16px; font-weight: 600; color: var(--navy); margin-bottom: 4px; }
.t-module p { font-size: 14px; color: var(--gray-500); line-height: 1.65; }

/* ===== PROCESS ===== */
.process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; position: relative; }
.process-steps::before { content: ''; position: absolute; top: 44px; left: 12.5%; right: 12.5%; height: 1px; background: rgba(255,255,255,0.08); }
.p-step { text-align: center; padding: 0 20px; position: relative; }
.p-step-circle { width: 88px; height: 88px; border-radius: 50%; background: rgba(196,162,101,0.06); border: 1.5px solid rgba(196,162,101,0.25); display: flex; align-items: center; justify-content: center; margin: 0 auto 28px; position: relative; z-index: 2; transition: all 0.3s; }
.p-step:hover .p-step-circle { border-color: var(--gold); background: rgba(196,162,101,0.1); }
.p-step-num { font-family: var(--font-display); font-size: 30px; font-weight: 600; color: var(--gold); }
.p-step h4 { font-family: var(--font-display); font-size: 22px; font-weight: 600; color: var(--white); margin-bottom: 12px; }
.p-step p { font-size: 14px; color: var(--gray-400); line-height: 1.7; }

/* ===== INSURANCE ===== */
.vl-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
.vl-card { background: var(--white); border: 1px solid var(--gray-100); border-radius: var(--radius-lg); padding: 48px; transition: all 0.35s; }
.vl-card:hover { border-color: var(--gold); box-shadow: var(--shadow-soft); }
.vl-card h3 { font-family: var(--font-display); font-size: 26px; font-weight: 600; color: var(--navy); margin-bottom: 16px; line-height: 1.25; }
.vl-card p { font-size: 15px; color: var(--gray-500); line-height: 1.8; margin-bottom: 16px; }
.vl-card p:last-child { margin-bottom: 0; }
.vl-accent { font-family: var(--font-display); font-size: 18px; font-weight: 600; font-style: italic; color: var(--gold-dark) !important; }

/* ===== POSITIONING ===== */
.positioning-content { text-align: center; max-width: 720px; margin: 0 auto; }
.positioning-content .section-subtitle { margin-left: auto; margin-right: auto; }
.pos-features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin: 48px 0; }
.pos-feat { padding: 40px 28px; background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--radius); text-align: center; transition: all 0.3s; }
.pos-feat:hover { border-color: rgba(196,162,101,0.2); background: rgba(196,162,101,0.03); }
.pos-feat-icon { width: 30px; height: 30px; margin: 0 auto 18px; }
.pos-feat-icon svg { width: 100%; height: 100%; }
.pos-feat h4 { font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--white); margin-bottom: 10px; }
.pos-feat p { font-size: 14px; color: var(--gray-400); line-height: 1.7; }
.positioning-quote { font-family: var(--font-display); font-size: 24px; font-weight: 500; font-style: italic; color: var(--gold-light); line-height: 1.45; margin: 56px 0 0; padding-top: 48px; border-top: 1px solid rgba(255,255,255,0.06); }

/* ===== CTA ===== */
.cta-section { padding: 120px 0; background: linear-gradient(170deg, var(--navy) 0%, var(--navy-mid) 100%); text-align: center; color: var(--white); position: relative; overflow: hidden; }
.cta-section::before { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 700px; height: 700px; background: radial-gradient(circle, rgba(196,162,101,0.04) 0%, transparent 55%); border-radius: 50%; }
.cta-content { position: relative; z-index: 2; }
.cta-badge-mini { width: 80px; height: 80px; margin: 0 auto 32px; opacity: 0.6; }
.cta-badge-mini svg { width: 100%; height: 100%; }
.cta-content h2 { font-family: var(--font-display); font-size: clamp(30px, 4vw, 48px); font-weight: 500; margin-bottom: 20px; line-height: 1.15; }
.cta-content p { font-size: 17px; color: var(--gray-300); max-width: 500px; margin: 0 auto 44px; line-height: 1.85; font-weight: 300; }
.cta-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px; }
.cta-phone { font-size: 14px; color: var(--gray-400); }
.cta-phone a { color: var(--gold-light); text-decoration: none; font-weight: 500; }
.cta-phone a:hover { text-decoration: underline; }

/* ===== FOOTER ===== */
footer { background: var(--navy-deep); color: var(--gray-400); padding: 56px 0 36px; font-size: 13px; }
.footer-upper { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 40px; padding-bottom: 40px; border-bottom: 1px solid rgba(255,255,255,0.06); }
.footer-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
.footer-brand-text { font-family: var(--font-display); font-size: 18px; font-weight: 600; color: var(--white); }
.footer-tagline { font-family: var(--font-display); font-style: italic; font-size: 16px; color: var(--gold); margin-bottom: 16px; }
.footer-checks { list-style: none; margin-top: 20px; font-size: 12px; color: rgba(255,255,255,0.5); }
.footer-checks li { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.footer-checks li::before { content: '\2713'; color: var(--gold); }
.footer-desc { font-size: 13px; color: var(--gray-400); line-height: 1.7; max-width: 340px; }
.footer-col h5 { font-size: 11px; font-weight: 700; color: var(--gray-200); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px; }
.footer-col a { display: block; font-size: 13px; color: var(--gray-400); text-decoration: none; padding: 4px 0; transition: color 0.2s; }
.footer-col a:hover { color: var(--gold); }
.footer-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 12px; color: var(--gray-500); }


/* ===== RESPONSIVE ===== */
@media (max-width: 960px) {
  .hero { display: block; min-height: 0; padding-bottom: 0; }
  .hero-content { grid-template-columns: 1fr; gap: 0; padding-top: 64px; padding-bottom: 48px; }
  .hero-right { display: none; }
  .hero-stats { position: relative; }
  .hero-sub { font-size: 16px; }
  .nav-links, .nav-right { display: none; }
  .nav-toggle { display: flex; }
  .nav .container { height: 64px; }
  .nav-spacer { height: 64px; }
  .waarom-grid { grid-template-columns: 1fr; }
  .cert-layout { grid-template-columns: 1fr; gap: 48px; }
  .cert-badge-area { order: -1; }
  .voordelen-grid { grid-template-columns: 1fr; }
  .training-layout { grid-template-columns: 1fr; gap: 48px; }
  .vl-layout { grid-template-columns: 1fr; }
  .footer-upper { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .section { padding: 80px 0; }
  .hero-content { padding-top: 56px; padding-bottom: 36px; }
  .hero h1 { font-size: 30px; }
  .hero-sub { font-size: 15px; line-height: 1.65; }
  .hero-usps { flex-direction: column; gap: 8px; }
  .hero-actions { flex-direction: column; align-items: stretch; gap: 12px; }
  .btn-primary, .btn-white { justify-content: center; padding: 12px 28px; font-size: 12px; }
  .hero-stats .container { grid-template-columns: 1fr 1fr; gap: 12px; }
  .hero-stat strong { font-size: 22px; }
  .hero-stat span { font-size: 10px; }
  .process-steps { grid-template-columns: 1fr 1fr; gap: 32px; }
  .process-steps::before { display: none; }
  .pos-features { grid-template-columns: 1fr; gap: 16px; }
  .nav-links { display: none; }
  .cert-badge-showcase { width: 260px; height: 260px; }
}

@media (max-width: 480px) {
  .container { padding: 0 20px; }
  .process-steps { grid-template-columns: 1fr; }
  .hero-content { padding-top: 40px; padding-bottom: 20px; }
  .hero h1 { font-size: 26px; line-height: 1.18; }
  .hero-badge { font-size: 10px; letter-spacing: 0.15em; }
  .hero-sub { font-size: 14px; line-height: 1.6; }
  .btn-primary, .btn-white { padding: 11px 24px; font-size: 11px; }
}

/* Zakelijke voettekst: regels zonder link, zelfde ritme als de links ernaast */
.footer-plain { display:block; color: var(--gray-300); font-size: .875rem; line-height: 1.7; margin-bottom: .35rem; }
.footer-col h5 { letter-spacing: .14em; }
</style>
</head>
<body>

<!-- ===== SVG DEFINITIONS ===== -->
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <!-- Geometric faceted shield: three gold planes, echoing the SAJ cube monogram -->
  <symbol id="psg-shield" viewBox="0 0 200 240">
    <path d="M100 14 L178 42 L178 122 C178 172 141 208 100 226 C59 208 22 172 22 122 L22 42 Z" fill="#A68B52"/>
    <path d="M100 14 L178 42 L178 122 C178 172 141 208 100 226 L100 14 Z" fill="#C8A96E"/>
    <path d="M100 14 L178 42 L100 70 L22 42 Z" fill="#D9C08C"/>
    <path d="M100 40 L158 60 L158 120 C158 157 131 185 100 199 C69 185 42 157 42 120 L42 60 Z" fill="none" stroke="#0E1630" stroke-width="2.2" opacity="0.5"/>
    <line x1="100" y1="70" x2="100" y2="226" stroke="#0E1630" stroke-width="1.4" opacity="0.32"/>
  </symbol>

  <!-- Certification badge: shield inside a text band — PRIVACY SHIELD GROUP / INDEPENDENT CERTIFICATION -->
  <symbol id="psg-badge" viewBox="0 0 300 300">
    <circle cx="150" cy="150" r="141" fill="none" stroke="#C8A96E" stroke-width="1.6"/>
    <circle cx="150" cy="150" r="136" fill="none" stroke="#C8A96E" stroke-width="0.5" opacity="0.45"/>
    <circle cx="150" cy="150" r="100" fill="none" stroke="#C8A96E" stroke-width="1"/>
    <!-- text band = r 100..136, centre r 118; both texts sit centred in the band -->
    <path id="psgArcTop" d="M37 150 A113 113 0 0 1 263 150" fill="none"/>
    <path id="psgArcBottom" d="M26 150 A124 124 0 0 0 274 150" fill="none"/>
    <text font-family="'Inter', Helvetica, Arial, sans-serif" font-size="14" font-weight="700" letter-spacing="4.5" fill="#C8A96E">
      <textPath href="#psgArcTop" startOffset="50%" text-anchor="middle">PRIVACY SHIELD GROUP</textPath>
    </text>
    <text font-family="'Inter', Helvetica, Arial, sans-serif" font-size="10" font-weight="600" letter-spacing="3.5" fill="#C8A96E" opacity="0.85">
      <textPath href="#psgArcBottom" startOffset="50%" text-anchor="middle">INDEPENDENT CERTIFICATION</textPath>
    </text>
    <use href="#psg-facet" x="25" y="143" width="14" height="14"/>
    <use href="#psg-facet" x="261" y="143" width="14" height="14"/>
    <use href="#psg-shield" x="90" y="78" width="120" height="144"/>
  </symbol>

  <!-- Small faceted mark for list icons -->
  <symbol id="psg-facet" viewBox="0 0 24 24">
    <path d="M12 2 L22 12 L12 22 L2 12 Z" fill="#A68B52"/>
    <path d="M12 2 L22 12 L12 12 Z" fill="#D9C08C"/>
    <path d="M12 12 L22 12 L12 22 Z" fill="#C8A96E"/>
  </symbol>
</svg>

