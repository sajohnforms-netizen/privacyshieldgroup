<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-content">
    <div class="hero-left">
      <span class="hero-badge">Independent Privacy Certification</span>
      <h1>Privacy Certification for Hotels, Independent and Verifiable</h1>
      <div class="hero-divider" aria-hidden="true"></div>
      <p class="hero-sub">Privacy Shield Group offers the first independent privacy certificate for the hospitality industry. Strengthen guest confidence, distinguish your hotel and stay ahead of the future of guest safety.</p>
      <ul class="hero-usps">
        <li>Independent certification</li>
        <li>GDPR-aligned framework</li>
        <li>Hospitality specialists</li>
      </ul>
      <div class="hero-actions">
        <a href="#contact" class="btn-primary">Request a consultation</a>
        <a href={`tel:${company.phoneHref}`} class="btn-white">
          <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          Call {company.phoneDisplay}
        </a>
      </div>
    </div>
